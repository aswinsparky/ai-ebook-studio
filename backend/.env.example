# ===================================================
# AI Ebook Studio - Backend Environment Configuration
# ===================================================

# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or set USE_MOCK_AI=true to use the built-in offline mock provider for testing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
USE_MOCK_AI=false

# Application Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# SQLite Database
DATABASE_URL=sqlite:///./ebook_studio.db

# Storage Directories
EXPORTS_DIR=./exports
UPLOADS_DIR=./uploads

